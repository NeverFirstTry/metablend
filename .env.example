# Copy to .env.local and fill in your own values. Never commit real keys.
# Required: the three Supabase values. Everything else is optional.

# Supabase: your own development project, never the production one
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only; the database has row level security on (supabase/dev-schema.sql), so the server needs it
SUPABASE_SERVICE_ROLE_KEY=

# Weather sources: a source without its key is skipped
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
# WeatherAPI's EU-only hostname, if they give you one (default: api.weatherapi.com)
WEATHERAPI_HOST=
# also the daily calibration source
VISUAL_CROSSING_KEY=
# free tier at pirateweather.net
PIRATE_WEATHER_KEY=
# Meteostat through RapidAPI, for the nightly validation
RAPIDAPI_KEY=

# Scheduled jobs and admin (any long random strings)
# gates the station calibration, self-calibration, push dispatch and warnings refresh
CALIBRATE_SECRET=
# gates the cron jobs (/api/calibrate, /api/cleanup, /api/webhook); Vercel sends it to its crons
CRON_SECRET=
# where low-confidence alerts go (optional)
WEBHOOK_URL=

# Other
# another Nominatim server for the place search (default: the public one)
NOMINATIM_URL=
# the local server's own address when it is not on port 3000, e.g. http://localhost:3123
SELF_BASE=
