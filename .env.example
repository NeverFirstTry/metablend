# Copy to .env.local and fill in your own values. Never commit real keys.
# Required: the three Supabase values. Everything else is optional.

# Supabase: your own development project, never the production one
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only; the database has row level security on (supabase/dev-schema.sql), so the server needs it
SUPABASE_SERVICE_ROLE_KEY=

# Weather sources: a source without its key is skipped
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
# WeatherAPI's EU-only hostname, if they give you one (default: api.weatherapi.com)
WEATHERAPI_HOST=
# also the daily calibration source
VISUAL_CROSSING_KEY=
# free tier at pirateweather.net
PIRATE_WEATHER_KEY=
# Meteostat through RapidAPI, for the nightly validation
RAPIDAPI_KEY=

# Scheduled jobs and admin (any long random strings)
# gates the station calibration, self-calibration, push dispatch and warnings refresh
CALIBRATE_SECRET=
# gates the cron jobs (/api/calibrate, /api/cleanup, /api/webhook); Vercel sends it to its crons
CRON_SECRET=
# where low-confidence alerts go (optional)
WEBHOOK_URL=

# Other
# set to "off" once the Open-Meteo plan has no archive host (Standard): a place's climate is then never
# asked, only read from the database or borrowed from a place nearby (lib/climate-store.js)
OPEN_METEO_ARCHIVE=
# our own Open-Meteo server (lib/open-meteo.js, "our own server"); all unset: the public service, as before
# its address, https and no path: forecasts, heights and air quality are asked there first
OPEN_METEO_SELF=
# the Cloudflare Access service token of the tunnel in front of it; sent to that address only
OPEN_METEO_SELF_ID=
OPEN_METEO_SELF_SECRET=
# how long it may take while the public service stands behind it, in ms (default 4000)
OPEN_METEO_SELF_TIMEOUT_MS=
# set to "off" at launch, for good: the public service is never asked (its free tier is non-commercial)
OPEN_METEO_PUBLIC=
# the comparison run: a share (0.2 = one request in five). The public service keeps answering; that share
# is also asked from our server and the two answers are compared and counted. Nothing shown comes from ours
OPEN_METEO_SHADOW=
# another Nominatim server for the place search (default: the public one)
NOMINATIM_URL=
# the local server's own address when it is not on port 3000, e.g. http://localhost:3123
SELF_BASE=
