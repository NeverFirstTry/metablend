# Geocoder configuration (defaults identify g-radio)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=g-radio@example.com
# Optional:
# GEOCODER_ACCEPT_LANGUAGE=en
# GEOCODER_API_KEY=your_provider_key   # if using a hosted provider
# Redis URL for caching (optional). If not set, an in-memory cache is used.
# REDIS_URL=redis://localhost:6379
# TTL for cached geocoding results (seconds)
# GEOCODER_CACHE_TTL_SEC=300
# Rate limiter settings (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
