    "Now, the next hours or the next days for a city.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt, die nächsten Stunden oder Tage für einen Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant, les prochaines heures ou les prochains jours pour une ville."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, las próximas horas o los próximos días para una ciudad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora, le prossime ore o i prossimi giorni per una città."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu, de komende uren of dagen voor een stad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz, najbliższe godziny lub dni dla miasta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď, příští hodiny nebo dny pro jedno město."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj, naslednje ure ali dnevi za en kraj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, as próximas horas ou dias de uma cidade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市の現在、この先の数時間、または数日間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个城市的现在、未来几小时或未来几天。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 도시의 지금, 앞으로 몇 시간 또는 며칠."
          }
        }
      }
    },
