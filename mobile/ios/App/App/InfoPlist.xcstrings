        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do znajdowania szczytów w twojej okolicy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slouží k nalezení horských vrcholů ve vašem okolí."
