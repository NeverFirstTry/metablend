    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Used to find mountain peaks near you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um Berggipfel in deiner Nähe zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à trouver les sommets près de vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para encontrar cumbres cerca de ti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve a trovare le vette vicino a te."
          }
        },
