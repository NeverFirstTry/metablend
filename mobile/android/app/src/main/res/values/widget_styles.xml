<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget type (docs/widgets-spec.md, section 4). Colours are set per theme at run time. -->
<resources>
    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/w_default_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- place or peak name -->
    <style name="WidgetName" parent="WidgetText">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- day, condition, labels, high and low, rain and wind, update time -->
    <style name="WidgetSecondary" parent="WidgetText">
        <item name="android:textColor">@color/w_default_muted</item>
    </style>
    <style name="WidgetTemp" parent="WidgetText">
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <!-- the summit window; 22 sp in the small widget, a sentence in 15 sp (set at run time) -->
    <style name="WidgetWindow" parent="WidgetText">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetCellMain" parent="WidgetText">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetIcon">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
