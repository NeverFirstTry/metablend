# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Claude Code settings (the project skill is shared)
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev-server log
_dev.log

# brainstorming companion mockups
.superpowers/

# signing keys and service credentials (never commit)
*.p8
*.p12
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
*service-account*.json

# downloaded and built datasets (scripts/places)
/data/

# agent tooling: a locally installed skill (it copies third-party pages) and the
# note `next dev` writes on every run
/.agents/
/skills-lock.json
/AGENTS.md
/graphify-out/

.vercel

# the Playwright MCP writes page snapshots and console logs here
/.playwright-mcp/
